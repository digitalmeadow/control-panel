{
  "name": "@digitalmeadow/control-panel",
  "version": "3.0.3",
  "type": "module",
  "description": "A minimalist, framework-agnostic control panel GUI",
  "author": "Digital Meadow <inbox@digitalmeadow.studio> (https://digitalmeadow.studio)",
  "keywords": [
    "control panel",
    "gui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalmeadow/control-panel.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "font:subset": "python3 fonts-src/build-font.py"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
